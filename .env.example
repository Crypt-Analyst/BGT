# Django Core
DJANGO_SECRET_KEY=your-secret-key-here-min-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,example.com
DJANGO_ENABLE_SSL=True
DJANGO_SECURE_SSL_REDIRECT=False

# CORS & CSRF
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:5173,https://127.0.0.1:5173,https://example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://localhost:5173,https://127.0.0.1:5173,https://example.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_ATOMIC_REQUESTS=True

# Email
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=your-email@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=no-reply@bwireglobaltech.com
CONTACT_EMAIL=contact@bwireglobaltech.com

# OpenAI
OPENAI_API_KEY=sk-...

# Celery & Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TIME_LIMIT=300
REDIS_URL=redis://redis:6379/1

# Analytics & Monitoring
GOOGLE_ANALYTICS_MEASUREMENT_ID=G-...
GOOGLE_OPTIMIZE_CONTAINER_ID=
SENTRY_DSN=

# Security (Production)
DJANGO_SECURE_PROXY_SSL_HEADER=False

# Encryption (Generate using: python manage.py shell)
# from home.security import generate_encryption_key; print(generate_encryption_key())
ENCRYPTION_KEY=generate-new-key-using-shell-command

# Rate Limiting
CHAT_RATE_LIMIT_MAX_REQUESTS=12
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
